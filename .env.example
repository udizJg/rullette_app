TZ=America/Santiago
NODE_ENV=production

# Abril 2026: 9 fechas (tote 1=sí, 0=no). Anula CAMPAIGN_START / DAILY_WINDOWS / TOTE_*.
CAMPAIGN_SCHEDULE=2026-04-07,12:00-14:00,1|2026-04-09,12:00-14:00,0|2026-04-11,13:00-15:00,1|2026-04-12,13:00-15:00,0|2026-04-14,12:00-14:00,1|2026-04-16,13:00-15:00,0|2026-04-18,13:00-15:00,1|2026-04-24,12:00-14:00,0|2026-04-25,13:00-15:00,0

# Legacy (ignorado mientras exista CAMPAIGN_SCHEDULE):
# CAMPAIGN_START=2026-03-20
# DAYS_TOTAL=11
# DAILY_WINDOWS=...
# TOTE_FIRST_DAY_INDEX=3
# TOTE_INTERVAL_DAYS=2

PRIZE_PELOTA_CORAZON=30
PRIZE_TOTE=1
PRIZE_LLAVERO=30
PRIZE_BOTELLA=2
PRIZE_STICKERS=30
PRIZE_MORRAL=10
PRIZE_LONCHERA=2

PORT=3002
DATA_DIR=./data
WHEEL_SVG_PATH=/app/public/assets/wheel.svg

# Chicureo — /ruleta3.html. Formato: fecha,HH:mm-HH:mm|... (TZ=America/Santiago).
CHICUREO_SCHEDULE=2026-05-29,12:00-16:00|2026-05-30,12:00-16:00
CHICUREO_PRIZE_LIBRETA=3
CHICUREO_PRIZE_PARASOL=20
CHICUREO_PRIZE_LANYARD=99

# Bellavista — /ruleta5.html. Misma geometría y premios que Chicureo; estado e inventario separados.
BELLAVISTA_SCHEDULE=2026-05-28,12:00-16:00|2026-05-29,12:00-16:00
BELLAVISTA_PRIZE_LIBRETA=3
BELLAVISTA_PRIZE_PARASOL=20
BELLAVISTA_PRIZE_LANYARD=99

# Ruleta Guacamole — /ruleta4.html. Formato igual que CHICUREO_SCHEDULE (fecha,HH:mm-HH:mm|...).
# 50% «Siga participando» sin stock; el otro 50% sortea premios físicos. Sin tope de giros por tablet (control en tienda).
RULETA4_SCHEDULE=2026-05-16,12:00-15:00|2026-05-17,12:00-15:00|2026-05-30,12:00-15:00|2026-05-31,12:00-15:00
RULETA4_PRIZE_STICKERS=24
RULETA4_PRIZE_BOTELLA=2
RULETA4_PRIZE_PELOTA=40
RULETA4_PRIZE_LLAVERO=23
RULETA4_PRIZE_MORRAL=10
RULETA4_PRIZE_LONCHERA=2

# Ruleta Arauco — /ruleta_arauco.html. Formato: fecha,HH:mm-HH:mm|... (completar fechas reales).
# 30% «Siga participando» sin stock; 70% premio físico. Sin tope de giros por tablet (control en tienda).
ARAUCO_SCHEDULE=YYYY-MM-DD,11:00-16:00|YYYY-MM-DD,11:00-16:00
ARAUCO_PRIZE_PELOTA=100
ARAUCO_PRIZE_LLAVERO=100
ARAUCO_PRIZE_MORRAL=50
ARAUCO_PRIZE_LONCHERA=20
ARAUCO_PRIZE_TOTEBAG=4

# Ruleta 6 NIU locales — /ruleta6.html. Formato: fecha,HH:mm-HH:mm|...
NIU_SCHEDULE=2026-06-24,13:00-15:00|2026-06-25,13:00-15:00|2026-06-26,19:30-21:30|2026-06-27,13:00-15:00|2026-06-30,13:00-15:00|2026-07-01,13:00-15:00|2026-07-02,13:00-15:00|2026-07-03,13:00-15:00|2026-07-04,13:00-15:00|2026-07-07,13:00-15:00|2026-07-08,13:00-15:00|2026-07-09,13:00-15:00|2026-07-10,13:00-15:00|2026-07-11,13:00-15:00|2026-07-15,13:00-15:00|2026-07-17,13:00-15:00|2026-07-18,13:00-15:00|2026-07-24,13:00-15:00|2026-07-25,13:00-15:00
NIU_PRIZE_PELOTA=26
NIU_PRIZE_LONCHERA=5
NIU_PRIZE_BOTELLA=3
NIU_PRIZE_STICKERS=26
NIU_PRIZE_MORRAL=14

# Ruleta 7 NIU25 — /ruleta7.html. Activación única: sábado 25 de julio, 21:00-23:30.
# 30% de los giros cae en «Sigue participando» (resultado virtual, no descuenta stock).
NIU25_SCHEDULE=2026-07-25,21:00-23:30
NIU25_PRIZE_BOTELLA=5
NIU25_PRIZE_BOLSA=17
NIU25_PRIZE_SALSA_SOYA=9
NIU25_PRIZE_SALSA_UNAGUI=9
NIU25_PRIZE_CHAPITA=30
