# Zona horaria de la campaña (Luxon IANA)
TZ=America/Santiago

# Control de reglas:
# - development: ignora horario y límite por participante; el spin es dry-run (no persiste descuento).
# - production: aplica límite de 1 participación por participante en la ventana.
NODE_ENV=production

# Primer día calendario de la campaña (YYYY-MM-DD) en la TZ anterior
CAMPAIGN_START=2026-03-19

# Cantidad de días de activación (1..N)
DAYS_TOTAL=11

# Ventana por cada día: pipe | separa días. Cada segmento es HH:mm-HH:mm (24h).
# Debe haber exactamente DAYS_TOTAL segmentos (día 1 es el primero).
# El fin es EXCLUSIVO: 18:00-20:00 = activo desde las 18:00 hasta antes de las 20:00.
# Excepción: si el fin es 23:59, se trata como “hasta el final del día” (hasta medianoche).
DAILY_WINDOWS=18:00-20:00|17:00-19:00|18:30-20:30|19:00-21:00|16:00-18:00|18:00-20:00|17:30-19:30|18:00-20:00|19:30-21:30|17:00-19:00|18:15-20:15

# Cupos diarios por premio (tote solo aplica días 1-6 por lógica del servidor)
PRIZE_PELOTA_CORAZON=30
PRIZE_TOTE=1
PRIZE_LLAVERO=30
PRIZE_BOTELLA=2
PRIZE_STICKERS=30
PRIZE_MORRAL=10
PRIZE_LONCHERA=2

# Tote “día de por medio”.
# Para 11 días: first day = 3 e intervalo = 2 => días 3,5,7,9,11.
TOTE_FIRST_DAY_INDEX=3
TOTE_INTERVAL_DAYS=2

PORT=3000
# Carpeta para persistencia JSON atómica
DATA_DIR=./data
