TZ=America/Santiago
NODE_ENV=production

# Abril 2026: 9 fechas (tote 1=sí, 0=no). Anula CAMPAIGN_START / DAILY_WINDOWS / TOTE_*.
CAMPAIGN_SCHEDULE=2026-04-07,12:00-14:00,1|2026-04-09,12:00-14:00,0|2026-04-11,13:00-15:00,1|2026-04-12,13:00-15:00,0|2026-04-14,12:00-14:00,1|2026-04-16,13:00-15:00,0|2026-04-18,13:00-15:00,1|2026-04-24,12:00-14:00,0|2026-04-25,13:00-15:00,0

# Legacy (ignorado mientras exista CAMPAIGN_SCHEDULE):
# CAMPAIGN_START=2026-03-20
# DAYS_TOTAL=11
# DAILY_WINDOWS=...
# TOTE_FIRST_DAY_INDEX=3
# TOTE_INTERVAL_DAYS=2

PRIZE_PELOTA_CORAZON=30
PRIZE_TOTE=1
PRIZE_LLAVERO=30
PRIZE_BOTELLA=2
PRIZE_STICKERS=30
PRIZE_MORRAL=10
PRIZE_LONCHERA=2

PORT=3002
DATA_DIR=./data
WHEEL_SVG_PATH=/app/public/assets/wheel.svg

# Chicureo — /ruleta3.html. Ejemplo: fechas confirmadas + ventana horaria (TZ=America/Santiago).
# Agregar más días con |. Stock por día de activación (ej. 3 libretas, 20 parasoles, 99 lanyards).
CHICUREO_SCHEDULE=2026-05-15,13:00-15:00|2026-05-16,13:00-15:00
CHICUREO_PRIZE_LIBRETA=3
CHICUREO_PRIZE_PARASOL=20
CHICUREO_PRIZE_LANYARD=99
